# Copy to .env for local runs: `set -a; . ./.env; set +a; make run`

# --- HTTP ---
ADDR=:8080
BASE_URL=http://localhost:8080
APP_ENV=development
# COOKIE_SECURE=true once you are behind HTTPS.
COOKIE_SECURE=false
# Comma-separated CIDRs of proxies whose X-Forwarded-* headers to trust.
TRUSTED_PROXIES=

# --- Database ---
DATABASE_URL=postgres://travel:travel@localhost:5432/travel?sslmode=disable
# Or set PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE instead and leave DATABASE_URL empty.

# --- Prompt context (the ConfigMap in Kubernetes) ---
PROMPT_CONTEXT_FILE=deploy/k8s/prompt-context.yaml

# --- Hero photos (optional) ---
# Free key from https://unsplash.com/developers. Leave empty to render the
# plain color-gradient hero instead of a photo. Costs no AI tokens — it's a
# plain HTTP lookup by destination, not a model call.
UNSPLASH_ACCESS_KEY=

# --- AI provider: anthropic | openai | local | stub ---
AI_PROVIDER=stub

# anthropic
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_EFFORT=high          # low | medium | high | xhigh | max

# openai
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o
# AI_BASE_URL=https://api.openai.com/v1

# local (Ollama, llama.cpp, vLLM, LM Studio — anything OpenAI-compatible)
# AI_PROVIDER=local
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

AI_MAX_TOKENS=32000
AI_TIMEOUT=10m

# --- Limits ---
DAILY_GENERATION_LIMIT=25
GENERATION_TIMEOUT=10m
SESSION_TTL=720h
